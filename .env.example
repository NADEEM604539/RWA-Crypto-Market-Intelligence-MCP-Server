# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Required: CoinMarketCap API key.
# This stays on the server side. Do not expose it to the remote agent client.
CMC_API_KEY=your_cmc_api_key_here #useful for testing in actual this comes in the header for authentication

# Optional: only needed if you wire an LLM directly into this server(used only for testing)
OPENAI_API_KEY=working api keys only used for testing not used in productio
MODEL_BASE_URL=local agent model only useful during testing through streamlit app

# Optional overrides — defaults are fine for the Startup tier.
CMC_BASE_URL=https://pro-api.coinmarketcap.com
CMC_TIMEOUT_SECONDS=10.0
CMC_RATE_LIMIT_PER_MINUTE=30
CMC_MAX_RETRIES=3
CMC_RETRY_BACKOFF_BASE_SECONDS=1.0