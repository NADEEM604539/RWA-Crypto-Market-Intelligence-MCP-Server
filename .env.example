# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Required: CoinMarketCap API key.
# This stays on the server side. Do not expose it to the remote agent client.
CMC_API_KEY=your_cmc_api_key_here

# Required for secure remote MCP access from an agent or Claude Desktop.
# The remote client should send: Authorization: Bearer <MCP_AUTH_TOKEN>
MCP_AUTH_TOKEN=replace_with_a_strong_random_token
MCP_AUTH_HEADER_NAME=Authorization
MCP_AUTH_SCHEME=Bearer
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Optional: only needed if you wire an LLM directly into this server.
OPENAI_API_KEY=
MODEL_BASE_URL=

# Optional overrides — defaults are fine for the Startup tier.
CMC_BASE_URL=https://pro-api.coinmarketcap.com
CMC_TIMEOUT_SECONDS=10.0
CMC_RATE_LIMIT_PER_MINUTE=30
CMC_MAX_RETRIES=3
CMC_RETRY_BACKOFF_BASE_SECONDS=1.0
